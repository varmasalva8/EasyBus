########################################
# Java + Spring Boot + Maven Projects  #
########################################

# Maven build output
/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
!/.mvn/wrapper/maven-wrapper.properties

# Logs
*.log
logs/

# Spring Boot configuration (local only)
application-*.yml
application-*.yaml
application-*.properties

########################################
# IDE Specific                          #
########################################

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
bin/

# VS Code
.vscode/

########################################
# OS / System files                     #
########################################
.DS_Store
Thumbs.db

########################################
# Temporary / Backup files              #
########################################
*.swp
*.swo
*~
*.bak

########################################
# Test Reports                          #
########################################
/target/surefire-reports/
/target/failsafe-reports/

########################################
# Databases                             #
########################################
*.h2.db
*.mv.db
*.trace.db

########################################
# Docker                                #
########################################
# Ignore Docker files that should not be pushed
docker-compose.override.yml
.docker/
.dockerignore

# Docker build output
*.tar
*.pid

########################################
# Kubernetes                            #
########################################
# Ignore local K8s config files
k8s-local/
*.kubeconfig
*.yaml~
*.yml~

########################################
# Node / Frontend (if exists)           #
########################################
node_modules/
dist/
build/
npm-debug.log
yarn-error.log
